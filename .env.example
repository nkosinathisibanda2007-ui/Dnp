# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# VERCEL: Set automatically by Vercel deployment environments.
VERCEL=

# SESSION_SECRET: Cryptographic secret used for signing and verifying JWT session tokens.
SESSION_SECRET=

# FIREBASE_SERVICE_ACCOUNT_KEY: (Optional) Full JSON string of the Firebase Admin service account key for server-side operations in Vercel.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Alternatively, set individual Firebase Admin credentials:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=

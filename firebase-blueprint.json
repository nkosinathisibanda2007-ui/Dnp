{
  "entities": {
    "CmsContent": {
      "title": "CmsContent",
      "description": "Master CMS content for Dzinopona Farms including site settings, agricultural divisions, projects, and hub locations.",
      "type": "object",
      "properties": {
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        },
        "updatedBy": {
          "type": "string",
          "description": "Admin identifier or email"
        },
        "version": {
          "type": "number",
          "description": "Schema version number"
        }
      },
      "required": ["updatedAt"]
    },
    "ContactSubmission": {
      "title": "ContactSubmission",
      "description": "Customer inquiry or quote request submitted through the website.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique inquiry ID"
        },
        "name": {
          "type": "string",
          "description": "Customer full name",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "description": "Customer contact email",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Customer phone number",
          "maxLength": 40
        },
        "interest": {
          "type": "string",
          "description": "Agricultural division or service category",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "description": "Inquiry text",
          "maxLength": 3000
        },
        "submittedAt": {
          "type": "string",
          "description": "ISO timestamp of submission"
        },
        "status": {
          "type": "string",
          "description": "Review status",
          "enum": ["new", "reviewed", "contacted", "archived"]
        }
      },
      "required": ["id", "name", "email", "message", "submittedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Staff profile record for admins and editors with assigned granular permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "editor"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable operational log entry recording modifications made across portal modules.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "username": { "type": "string" },
        "action": { "type": "string" },
        "module": { "type": "string" },
        "summary": { "type": "string" }
      },
      "required": ["id", "timestamp", "username", "action", "module", "summary"]
    },
    "MediaMetadata": {
      "title": "MediaMetadata",
      "description": "Metadata for uploaded imagery and video assets hosted in Firebase Storage.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "path": { "type": "string" },
        "filename": { "type": "string" },
        "contentType": { "type": "string" },
        "size": { "type": "number" },
        "uploadedAt": { "type": "string" },
        "uploadedBy": { "type": "string" }
      },
      "required": ["id", "url", "uploadedAt"]
    },
    "SystemMetadata": {
      "title": "SystemMetadata",
      "description": "System state tracking documents such as bootstrap completion status.",
      "type": "object",
      "properties": {
        "hasAdmin": { "type": "boolean" },
        "bootstrappedAt": { "type": "string" }
      }
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Health check connection test document.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Status message"
        }
      }
    }
  },
  "firestore": {
    "/cms_data/{docId}": {
      "schema": "CmsContent",
      "description": "Global CMS content storage for live farm portal configuration and content"
    },
    "/submissions/{submissionId}": {
      "schema": "ContactSubmission",
      "description": "Client quote inquiries and commercial farm consultation requests"
    },
    "/enquiries/{enquiryId}": {
      "schema": "ContactSubmission",
      "description": "Customer inquiries and quote requests"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and permission records"
    },
    "/audit_logs/{auditId}": {
      "schema": "AuditLogEntry",
      "description": "Historical audit logging trail"
    },
    "/media_meta/{mediaId}": {
      "schema": "MediaMetadata",
      "description": "Metadata for media files"
    },
    "/system_meta/{metaId}": {
      "schema": "SystemMetadata",
      "description": "System initialization and bootstrap records"
    },
    "/test/{docId}": {
      "schema": "TestConnection",
      "description": "SDK initial connection verification"
    }
  }
}
